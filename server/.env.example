# Backend PRIsME Prime — variables d'environnement

# Secret JWT (sessions + tokens MFA + clé de chiffrement du secret TOTP).
# OBLIGATOIRE en production. Utiliser une valeur aléatoire d'au moins 32 caractères.
JWT_SECRET=change-me-with-a-32char-random-secret

# (Optionnel) Clé de chiffrement MFA dédiée. À défaut, JWT_SECRET est utilisé.
# MFA_ENCRYPTION_KEY=

# Émetteur affiché dans l'application d'authentification (TOTP).
MFA_TOTP_ISSUER=PRIsME Prime BZ

# Base de données :
#  - Développement : SQLite (aucune config requise). Chemin optionnel :
# SQLITE_PATH=./data/app-prime.db
#  - Production : PostgreSQL (active automatiquement le mode PG).
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Administrateur initial créé au premier démarrage (si aucun admin n'existe).
SEED_ADMIN_EMAIL=jean-michel.caouette@bzinc.ca
SEED_ADMIN_PASSWORD=ChangeMoi!2026

# Port de l'API (défaut 4100).
PORT=4100

# URL du frontend autorisée en CORS (production).
# FRONTEND_URL=https://prime.exemple.ca
